{
  "name": "agentplatform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "22.23.3",
    "pnpm": "10.34.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "contracts:test": "node scripts/contracts.mjs --test",
    "links:check": "node scripts/check-links.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@tanstack/vue-query": "5.104.2",
    "eventsource-parser": "4.1.2",
    "naive-ui": "2.45.3",
    "openapi-fetch": "0.17.0",
    "pinia": "3.0.4",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "15.0.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.13",
    "yaml": "2.9.1"
  }
}
