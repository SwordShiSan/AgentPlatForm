{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentplatform:platform-event:v1",
  "title": "PlatformEvent",
  "description": "Version1 envelope; R1.2 freezes task/text/usage payloads below. Other enumerated capabilities remain unimplemented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "spaceId",
    "conversationId",
    "seq",
    "type",
    "occurredAt",
    "entityVersion",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "spaceId": {
      "type": "string",
      "format": "uuid"
    },
    "conversationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "taskId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "attemptId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "enum": [
        "task.accepted",
        "task.state_changed",
        "message.started",
        "message.delta",
        "message.completed",
        "message.replaced",
        "tool.prepared",
        "tool.started",
        "tool.completed",
        "interaction.opened",
        "interaction.resolved",
        "plan.revised",
        "artifact.created",
        "file.changed",
        "usage.updated",
        "workspace.state_changed",
        "workspace.environment_changed",
        "preview.state_changed",
        "capability.binding_changed",
        "credential.revoked",
        "membership.changed",
        "workflow.node_changed",
        "automation.occurrence_changed",
        "task.children_changed",
        "context.updated",
        "verification.updated",
        "file.version.created",
        "task.permissions_changed"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "entityVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.accepted"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taskId",
              "status"
            ],
            "properties": {
              "taskId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "const": "QUEUED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.state_changed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taskId",
              "status"
            ],
            "properties": {
              "taskId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "enum": [
                  "QUEUED",
                  "RUNNING",
                  "BLOCKED",
                  "SUCCEEDED",
                  "FAILED",
                  "CANCELLED",
                  "WAITING_INPUT"
                ]
              },
              "reasonCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cancelRequested": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.started"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "messageId",
              "blockId",
              "role"
            ],
            "properties": {
              "messageId": {
                "type": "string",
                "format": "uuid"
              },
              "blockId": {
                "type": "string",
                "format": "uuid"
              },
              "role": {
                "const": "ASSISTANT"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.delta"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "messageId",
              "blockId",
              "offset",
              "text"
            ],
            "properties": {
              "messageId": {
                "type": "string",
                "format": "uuid"
              },
              "blockId": {
                "type": "string",
                "format": "uuid"
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "messageId",
              "status"
            ],
            "properties": {
              "messageId": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "enum": [
                  "COMPLETED",
                  "PARTIAL",
                  "FAILED"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "usage.updated"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "callId",
              "inputTokens",
              "outputTokens",
              "costMicros",
              "estimated"
            ],
            "properties": {
              "callId": {
                "type": "string",
                "format": "uuid"
              },
              "inputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "costMicros": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "estimated": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "workspace.state_changed",
              "workspace.environment_changed",
              "file.version.created"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "conversationId": {
            "type": "null"
          },
          "taskId": {
            "type": "null"
          },
          "attemptId": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workspace.state_changed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspaceId",
              "state",
              "environmentState",
              "operationId",
              "errorCode"
            ],
            "properties": {
              "workspaceId": {
                "type": "string",
                "format": "uuid"
              },
              "state": {
                "type": "string",
                "enum": [
                  "PROVISIONING",
                  "READY",
                  "ERROR",
                  "BLOCKED"
                ]
              },
              "environmentState": {
                "type": "string",
                "enum": [
                  "NOT_CREATED",
                  "PREPARING",
                  "READY",
                  "STOPPING",
                  "STOPPED",
                  "DELETING",
                  "DELETED",
                  "ERROR",
                  "BLOCKED"
                ]
              },
              "operationId": {
                "type": "string",
                "format": "uuid"
              },
              "errorCode": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workspace.environment_changed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspaceId",
              "state",
              "generation",
              "version",
              "operationId",
              "errorCode"
            ],
            "properties": {
              "workspaceId": {
                "type": "string",
                "format": "uuid"
              },
              "state": {
                "type": "string",
                "enum": [
                  "NOT_CREATED",
                  "PREPARING",
                  "READY",
                  "STOPPING",
                  "STOPPED",
                  "DELETING",
                  "DELETED",
                  "ERROR",
                  "BLOCKED"
                ]
              },
              "generation": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "operationId": {
                "type": "string",
                "format": "uuid"
              },
              "errorCode": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Z_]{1,64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "file.version.created"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspaceId",
              "fileId",
              "versionId",
              "revision"
            ],
            "properties": {
              "workspaceId": {
                "type": "string",
                "format": "uuid"
              },
              "fileId": {
                "type": "string",
                "format": "uuid"
              },
              "versionId": {
                "type": "string",
                "format": "uuid"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "plan.revised"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taskId",
              "revisionId",
              "revision",
              "version"
            ],
            "properties": {
              "taskId": {
                "type": "string",
                "format": "uuid"
              },
              "revisionId": {
                "type": "string",
                "format": "uuid"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "interaction.opened"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "interactionId",
              "taskId",
              "kind",
              "optional",
              "version",
              "expiresAt"
            ],
            "properties": {
              "interactionId": {
                "type": "string",
                "format": "uuid"
              },
              "taskId": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "enum": [
                  "PLAN_APPROVAL",
                  "QUESTION",
                  "TOOL_APPROVAL"
                ]
              },
              "optional": {
                "type": "boolean"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "interaction.resolved"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "interactionId",
              "taskId",
              "decision",
              "version"
            ],
            "properties": {
              "interactionId": {
                "type": "string",
                "format": "uuid"
              },
              "taskId": {
                "type": "string",
                "format": "uuid"
              },
              "decision": {
                "enum": [
                  "EXECUTE_PLAN",
                  "REVISE_PLAN",
                  "REJECT_PLAN",
                  "DELIVER_PLAN",
                  "ANSWER",
                  "SKIP",
                  "SUPERSEDED",
                  "EXPIRED",
                  "CANCELLED",
                  "ALLOW_ONCE",
                  "DENY"
                ]
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.permissions_changed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taskId",
              "permissionVersion",
              "mode",
              "change"
            ],
            "properties": {
              "taskId": {
                "type": "string",
                "format": "uuid"
              },
              "permissionVersion": {
                "type": "integer",
                "minimum": 1
              },
              "mode": {
                "type": "string",
                "enum": [
                  "RISK_BASED",
                  "FULL"
                ]
              },
              "change": {
                "type": "string",
                "enum": [
                  "MODE_CHANGED",
                  "GRANT_CREATED",
                  "GRANT_REVOKED"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "tool.prepared",
              "tool.started",
              "tool.completed"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "taskId"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "format": "uuid"
          },
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taskId",
              "operationId",
              "toolName",
              "status",
              "phase"
            ],
            "properties": {
              "taskId": {
                "type": "string",
                "format": "uuid"
              },
              "operationId": {
                "type": "string",
                "format": "uuid"
              },
              "toolName": {
                "enum": [
                  "workspace_list",
                  "workspace_read",
                  "workspace_write",
                  "workspace_shell"
                ]
              },
              "status": {
                "enum": [
                  "PREPARED",
                  "RUNNING",
                  "SUCCEEDED",
                  "FAILED",
                  "UNKNOWN",
                  "DENIED"
                ]
              },
              "phase": {
                "enum": [
                  "PREPARED",
                  "WAITING_APPROVAL",
                  "ENVIRONMENT_PREPARING",
                  "RUNNING",
                  "STOPPING",
                  "SEALING",
                  "SUCCEEDED",
                  "FAILED",
                  "UNKNOWN",
                  "DENIED"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
