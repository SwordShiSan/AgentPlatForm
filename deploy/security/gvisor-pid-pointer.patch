+
+func pidLimitPointer(value int64) *int64 { return &value }
+
+func TestPidPointerBoundaries(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		limit  *int64
+		v1, v2 string
+	}{
+		{"nil", nil, "", ""},
+		{"zero", pidLimitPointer(0), "", ""},
+		{"platform128", pidLimitPointer(128), "128", "128"},
+		{"unlimited", pidLimitPointer(-1), "", "max"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			spec := &specs.LinuxResources{Pids: &specs.LinuxPids{Limit: tc.limit}}
+			for _, version := range []string{"v1", "v2"} {
+				dir := t.TempDir()
+				path := filepath.Join(dir, "pids.max")
+				if err := os.WriteFile(path, []byte("unchanged"), 0600); err != nil {
+					t.Fatal(err)
+				}
+				want := tc.v1
+				var err error
+				if version == "v1" {
+					err = (&pids{}).set(spec, dir)
+				} else {
+					want = tc.v2
+					err = (&pid2{}).set(spec, dir)
+				}
+				if err != nil {
+					t.Fatalf("%s set: %v", version, err)
+				}
+				data, readErr := os.ReadFile(path)
+				if want == "" {
+					if readErr != nil || string(data) != "unchanged" {
+						t.Fatalf("%s unexpected write: %q, %v", version, data, readErr)
+					}
+				} else if readErr != nil || strings.TrimSpace(string(data)) != want {
+					t.Fatalf("%s got %q, %v; want %q", version, data, readErr, want)
+				}
+			}
+			props, err := (&pid2{}).generateProperties(spec)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if tc.limit == nil {
+				if len(props) != 0 {
+					t.Fatalf("nil limit must leave systemd unchanged: %v", props)
+				}
+			} else if len(props) != 1 || props[0].Value.Value() != uint64(*tc.limit) {
+				t.Fatalf("systemd PID value changed: %v", props)
+			}
+			if got := (&pids{}).skip(spec); (got != nil) != (tc.limit != nil && *tc.limit > 0) {
+				t.Fatalf("missing controller must reject positive PID limit: %v", got)
+			}
+		})
+	}
+}
