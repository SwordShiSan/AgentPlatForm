<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion><parent><groupId>com.agentplatform</groupId><artifactId>platform-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent><artifactId>platform-app</artifactId><dependencies>
  <dependency><groupId>com.agentplatform</groupId><artifactId>platform-trigger</artifactId></dependency>
  <dependency><groupId>com.agentplatform</groupId><artifactId>platform-infrastructure</artifactId></dependency>
  <dependency><groupId>com.agentplatform</groupId><artifactId>platform-domain</artifactId></dependency>
  <dependency><groupId>com.agentplatform</groupId><artifactId>platform-api</artifactId></dependency>
  <dependency><groupId>com.agentplatform</groupId><artifactId>platform-types</artifactId></dependency>
  <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
  <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
  <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><scope>test</scope></dependency>
</dependencies><build><plugins>
  <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
    <executions><execution><id>default-jar</id><configuration><excludes><exclude>com/agentplatform/renderer/**</exclude></excludes></configuration></execution></executions>
  </plugin>
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
    <!-- Use Boot's resolved test agent at JVM startup, avoiding restricted dynamic attach pipes. -->
    <configuration><argLine>"-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar"</argLine></configuration>
  </plugin>
</plugins></build>
<profiles><profile><id>preview-renderer</id>
  <dependencyManagement><dependencies>
    <dependency><groupId>com.google.errorprone</groupId><artifactId>error_prone_annotations</artifactId><version>2.41.0</version></dependency>
  </dependencies></dependencyManagement>
  <dependencies>
    <dependency><groupId>org.jodconverter</groupId><artifactId>jodconverter-local-lo</artifactId><version>5.1.1</version></dependency>
    <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>3.0.8</version></dependency>
    <dependency><groupId>com.twelvemonkeys.imageio</groupId><artifactId>imageio-webp</artifactId><version>3.13.1</version></dependency>
    <dependency><groupId>org.jsoup</groupId><artifactId>jsoup</artifactId><version>1.23.2</version></dependency>
    <dependency><groupId>org.apache.tika</groupId><artifactId>tika-parser-microsoft-module</artifactId><version>3.3.3</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.tika</groupId><artifactId>tika-core</artifactId><version>3.3.3</version><scope>provided</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
      <executions>
        <execution><id>renderer-source</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals><configuration><sources><source>src/renderer/java</source></sources></configuration></execution>
        <execution><id>renderer-tests</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals><configuration><sources><source>src/renderer-test/java</source></sources></configuration></execution>
      </executions>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
      <executions>
        <execution><id>renderer-jar</id><phase>package</phase><goals><goal>jar</goal></goals><configuration><classifier>renderer</classifier><includes><include>com/agentplatform/renderer/**</include></includes><excludes combine.self="override"/></configuration></execution>
      </executions>
    </plugin>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId>
      <configuration><excludeGroupIds>org.jodconverter,org.libreoffice,org.apache.pdfbox,com.twelvemonkeys.imageio,com.twelvemonkeys.common,org.jsoup,org.apache.tika,org.apache.poi,org.apache.xmlbeans,com.github.virtuald,com.healthmarketscience.jackcess</excludeGroupIds><excludes>
        <exclude><groupId>com.zaxxer</groupId><artifactId>SparseBitSet</artifactId></exclude>
        <exclude><groupId>org.apache.james</groupId><artifactId>apache-mime4j-core</artifactId></exclude>
        <exclude><groupId>org.apache.james</groupId><artifactId>apache-mime4j-dom</artifactId></exclude>
        <exclude><groupId>org.bouncycastle</groupId><artifactId>bcjmail-jdk18on</artifactId></exclude>
        <exclude><groupId>org.apache.commons</groupId><artifactId>commons-collections4</artifactId></exclude>
        <exclude><groupId>org.apache.commons</groupId><artifactId>commons-csv</artifactId></exclude>
        <exclude><groupId>org.apache.commons</groupId><artifactId>commons-math3</artifactId></exclude>
        <exclude><groupId>com.pff</groupId><artifactId>java-libpst</artifactId></exclude>
        <exclude><groupId>com.github.albfernandez</groupId><artifactId>juniversalchardet</artifactId></exclude>
      </excludes></configuration>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version>
      <executions><execution><id>renderer-libraries</id><phase>package</phase><goals><goal>copy-dependencies</goal></goals><configuration>
        <outputDirectory>${project.build.directory}/renderer-libs</outputDirectory><includeScope>compile</includeScope>
        <includeArtifactIds>jodconverter-core,jodconverter-local,jodconverter-local-lo,libreoffice,pdfbox,pdfbox-io,fontbox,commons-logging,imageio-webp,imageio-core,imageio-metadata,common-lang,common-io,common-image,jsoup,slf4j-api,gson,commons-io,commons-lang3,tika-core,tika-parser-microsoft-module,tika-parser-xml-module,tika-parser-text-module,tika-parser-html-module,tika-parser-mail-commons,tika-parser-zip-commons,poi,poi-ooxml,poi-ooxml-lite,poi-ooxml-full,poi-scratchpad,xmlbeans,commons-compress,commons-collections4,commons-math3,commons-codec,curvesapi,SparseBitSet,log4j-api,jcl-over-slf4j,commons-csv,juniversalchardet,jackcess,jackcess-encrypt,java-libpst,bcprov-jdk18on,bcutil-jdk18on,bcpkix-jdk18on,bcjmail-jdk18on,angus-activation,jakarta.activation-api,jakarta.mail-api</includeArtifactIds>
      </configuration></execution></executions>
    </plugin>
  </plugins></build>
</profile></profiles>
</project>
